{
  "name": "wordle-duel",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/generate-health-info.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playwright:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install chromium && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "install-registry": "npm install --registry=https://registry.npmjs.org/",
    "refresh-lock": "rm -rf node_modules package-lock.json && npm install --registry=https://registry.npmjs.org/"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.30.0",
    "@emotion/react": "^11.14.0",
    "@stomp/stompjs": "^7.2.1",
    "@tanstack/react-query": "^5.90.16",
    "i18next": "^24.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "7.18.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "^16.5.0",
    "jsdom": "29.1.1",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "8.1.4",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.2"
  }
}
